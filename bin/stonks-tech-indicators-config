#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  bin/stonks-tech-indicators-config [--env-file PATH]

Description:
  Loads the local Empire environment and validates the secret-safe technical-
  indicator configuration, calculation runtime, dependencies, database, and
  reviewed SPX benchmark identity. Output is one compact JSON object.

Options:
  --env-file PATH  Load an environment file before running.
                   Defaults to deploy/env/local.env.
  -h, --help       Show this help message.
EOF
}

ENV_FILE="deploy/env/local.env"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --env-file)
      ENV_FILE="${2:-}"
      if [[ -z "${ENV_FILE}" ]]; then
        echo "ERROR: --env-file requires a path." >&2
        exit 1
      fi
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unrecognized argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=bin/env-load
source "${REPO_ROOT}/bin/env-load" "${ENV_FILE}" >/dev/null

PYTHON_BIN="${REPO_ROOT}/packages/empire-stonks-tech-indicators/.venv/bin/python"

if [[ ! -x "${PYTHON_BIN}" ]]; then
  PYTHON_BIN="$(command -v python3 || true)"
fi

if [[ -z "${PYTHON_BIN}" ]]; then
  echo "ERROR: python3 was not found." >&2
  exit 1
fi

export PYTHONPATH="${REPO_ROOT}/packages/empire-stonks-tech-indicators/src:${REPO_ROOT}/packages/empire-core/src:${REPO_ROOT}/packages/empire-reports/src${PYTHONPATH:+:${PYTHONPATH}}"

if ! "${PYTHON_BIN}" -c 'import empire_core, empire_reports, empire_stonks_tech_indicators' >/dev/null 2>&1; then
  echo "ERROR: empire-stonks-tech-indicators dependencies are not installed for ${PYTHON_BIN}." >&2
  echo "       Run: cd packages/empire-stonks-tech-indicators && poetry install" >&2
  exit 1
fi

exec "${PYTHON_BIN}" -m empire_stonks_tech_indicators.scripts.config
