#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${REPO_ROOT}/packages/empire-reports/.venv/bin/python"

if [[ -z "${EMPIRE_TEMP_DIR:-}" ]]; then
  # shellcheck source=bin/env-load
  source "${REPO_ROOT}/bin/env-load" "${REPO_ROOT}/deploy/env/local.env" >/dev/null
fi

if [[ ! -x "${PYTHON_BIN}" ]]; then
  PYTHON_BIN="$(command -v python3 || true)"
fi

if [[ -z "${PYTHON_BIN}" ]]; then
  echo "ERROR: python3 was not found." >&2
  exit 1
fi

export PYTHONPATH="${REPO_ROOT}/packages/empire-reports/src${PYTHONPATH:+:${PYTHONPATH}}"

if ! "${PYTHON_BIN}" -c 'import empire_reports, reportlab' >/dev/null 2>&1; then
  echo "ERROR: empire-reports dependencies are not installed for ${PYTHON_BIN}." >&2
  echo "       Run: cd packages/empire-reports && poetry install" >&2
  exit 1
fi

cd "${REPO_ROOT}"
exec "${PYTHON_BIN}" -m empire_reports.playground "$@"
